% Reazione per le varie luci: modalità attuatore
reaction(
    out(act(light_mode(#, T))),
    (operation, completion),
    (
        lamp_#@localhost:20504 ? setEnv(light_mode_#, T)
    )
).

reaction(
    setEnv(light_mode_#, T),
    (from_env, completion),
    (
        in(act(light_mode(#, T)))
    )
).


% Reazione per le varie luci: modalità sensore

reaction(
    in(sense(light_state(#, T))),
    (operation, invocation),
    (
        lamp_#@localhost:20504 ? getEnv(light_state_#, T)
    )
).



reaction(
    getEnv(light_state_#, T),
    (from_env, completion),
    (
        out(sense(light_state(#, T)))
    )
).
