% Reazione per le varie luci: modalità attuatore
reaction(
    out(act(light_mode(3, T))),
    (operation, completion),
    (
        lamp_3@localhost:20504 ? setEnv(light_mode, T)
    )
).

% Reazione per le varie luci: modalità sensore

reaction(
    inp(sense(get_light_state(3, T))),
    (operation, invocation),
    (
        lamp_3@localhost:20504 ? getEnv(get_light_state, T)
    )
).

% Delete garbage tuple.
