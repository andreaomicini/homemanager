reaction(
    out(act(fridge_#, I, Q)),
    (operation, completion),
    (
        no(mutex(A,B)),
        out(mutex(I,Q)),
        no(content(fridge_#, I, A)),
        out(content(fridge_#, I, Q)),
        fridge#@localhost:20504 ? setEnv(I, Q)
    )
).

reaction(
    out(act(fridge_#, I, Q)),
    (operation, completion),
    (
        no(mutex(A,B)),
        out(mutex(I,Q)),
        in(content(fridge_#, I, A)),
        Y is A+Q,
        Y > 0,
        out(content(fridge_#, I, Y)),
        fridge#@localhost:20504 ? setEnv(I, Q)
    )
).

reaction(
    out(act(fridge_#, I, Q)),
    (operation, completion),
    (
        no(mutex(A,B)),
        out(mutex(I,Q)),
        in(content(fridge_#, I, A)),
        Y is A+Q,
        Y == 0,
        fridge#@localhost:20504 ? setEnv(I, Q)
    )
).

reaction(
    setEnv(I, Q),
    (from_env, completion),
    (
        in(mutex(I,Q)),
        in(act(fridge_#, I, Q))
    )
).

reaction(
    in(sense(fridge_#, I, Q)),
    (operation, invocation),
    (
        fridge#@localhost:20504 ? getEnv(I,Q)
    )
).

reaction(
    getEnv(I,Q),
    (from_env, completion),
    (
        out(sense(fridge_#, I, Q))
    )
).