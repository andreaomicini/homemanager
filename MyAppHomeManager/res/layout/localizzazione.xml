<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo2" >
    
    <TextView
        android:id="@+id/localizza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="Ricerca dei servizi"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
    <TextView 
        android:id="@+id/miTrovo"
        android:text="Ti trovi in:" 
        android:padding="5dp" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/localizza"
        android:layout_below="@+id/localizza"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
    
    <TextView 
        android:id="@+id/where" 
        android:padding="5dp" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/miTrovo"
        android:layout_below="@+id/miTrovo"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
       
    <TextView 
        android:id="@+id/cord1"
        android:text="Latitudine" 
        android:padding="5dp" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/where"
        android:layout_below="@+id/where"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
   	<TextView 
   	    android:id="@+id/latitude" 
   	    android:padding="5dp" 
   	    android:layout_width="wrap_content" 
   	    android:layout_height="wrap_content" 
   	    android:layout_alignLeft="@+id/cord1"
        android:layout_below="@+id/cord1"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView 
        android:id="@+id/cord2"
        android:text="Longitudine" 
        android:padding="5dp" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/latitude"
        android:layout_below="@+id/latitude"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    
    <TextView 
        android:id="@+id/longitude" 
        android:padding="5dp" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/cord2"
        android:layout_below="@+id/cord2"
        android:textAppearance="?android:attr/textAppearanceMedium" />

        
    <TextView
        android:id="@+id/lista"
	    android:text="Lista servizi trovati"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content" 
	    android:layout_alignLeft="@+id/longitude"
        android:layout_below="@+id/longitude"
        android:textAppearance="?android:attr/textAppearanceMedium" />

	<ListView
	    android:id="@+id/preferitiListView"
	    android:layout_width="fill_parent"
	    android:layout_height="fill_parent"
	    android:fastScrollEnabled="false"
	    android:layout_alignLeft="@+id/lista"
        android:layout_below="@+id/lista"/>

	
</RelativeLayout>
