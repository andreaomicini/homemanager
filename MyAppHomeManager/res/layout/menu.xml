<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo" >

    <TextView
        android:id="@+id/alias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="21dp"
        android:layout_marginTop="41dp" />

  

    <ImageButton
         android:id="@+id/fornoBottone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/condizionatoreBotton"
        android:src="@drawable/forno" />

    <ImageButton
        android:id="@+id/riscaldamentoBotton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/fornoBottone"
        android:src="@drawable/caldo" />

    <ImageButton
        android:id="@+id/localizza"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/riscaldamentoBotton"
        android:src="@drawable/localizza"
        android:text="Localizzami" />

    <ImageButton
        android:id="@+id/condizionatoreBotton"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignTop="@+id/alias"
        android:layout_marginTop="18dp"
        android:src="@drawable/freddo"
        android:text="Condizionatore" />

</RelativeLayout>
