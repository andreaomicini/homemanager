<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo2" >
    
    <TextView
        android:id="@+id/aliasForno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="CaptainOven"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <ToggleButton
        android:id="@+id/statoForno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/aliasForno"
        android:layout_below="@+id/aliasForno"
        android:layout_marginTop="71dp"
        android:text="ToggleButton" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/statoForno"
        android:layout_below="@+id/aliasForno"
        android:layout_marginTop="32dp"
        android:text="Current status"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:id="@+id/TestoTempForno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/statoForno"
        android:layout_below="@+id/statoForno"
        android:layout_marginTop="39dp"
        android:text="Temperature"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:id="@+id/TemperaturaSelezionataForno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/TestoTempForno"
        android:layout_marginRight="16dp"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <SeekBar
        android:id="@+id/BarraTemperaturaForno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/TemperaturaSelezionataForno"
        android:layout_marginTop="21dp"
        android:max="@integer/Max_Forno" />
        
    <Button
        android:id="@+id/salvaForno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/BarraTemperaturaForno"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="39dp"
        android:text="Save" />

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/textView1"
        android:layout_marginBottom="14dp"
        android:layout_toRightOf="@+id/salvaForno"
        android:src="@drawable/forno2" />

</RelativeLayout>
