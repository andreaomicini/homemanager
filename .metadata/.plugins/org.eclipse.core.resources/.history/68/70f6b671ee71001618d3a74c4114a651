package it.unibo.homemanager.scheduler;

import it.unibo.homemanager.tablemap.Device;

public class ScheduledDevice {

	private Device device;
	private String scheduleState;//può essere "SCHEDULED" "NOT SCHEDULED" "RUNNING"
	private String program;
	
	public ScheduledDevice(Device d, String ss, String prog)
	{
		this.device = d;
		this.scheduleState = ss;
		this.program = prog;
	}

	public Device getDevice() {
		return device;
	}

	public void setDevice(Device device) {
		this.device = device;
	}

	public String getScheduleState() {
		return scheduleState;
	}

	public void setScheduleState(String scheduleState) {
		this.scheduleState = scheduleState;
	}

	public String getProgram() {
		return program;
	}

	public void setProgram(String program) {
		this.program = program;
	}
}
