public class RunningThread extends Thread {
	
	private ScheduledDevice schDev;
	private Room r;
	private User u;
	private Vector tid;
	private int runningTime;
	
	public RunningThread(ScheduledDevice schDev, Room r, User u, Vector tid, int runningTime) {
		this.schDev 	 = schDev;
		this.r 			 = r;
		this.u 			 = u;
		this.tid 		 = tid;
		this.runningTime = runningTime;
	}
	
	public void run()
	{
		try {
			RunningThread.sleep(runningTime);
		} catch (InterruptedException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}
		
		
		//sending STOP cmd
		Utilities.sendCmd(r, schDev.getDevice(), "off", u, tid);
		
		schDev.setScheduleState("NOT SCHEDULED");
		schDev.setProgram("off");
		
		return;//thread close itself when its job is finished
	}
	
